<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tic Tac Toe</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    background: #070711;
    color: white;
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
}

.game {
    width: 92%;
    max-width: 400px;
    text-align: center;
}

h1 {
    font-size: 38px;
    color: #00eaff;
    text-shadow: 0 0 20px #00eaff;
    margin-bottom: 8px;
}

.subtitle {
    color: #999;
    margin-bottom: 20px;
}

.score {
    display: flex;
    justify-content: space-around;
    background: #111122;
    border: 1px solid #292950;
    border-radius: 15px;
    padding: 14px;
    margin-bottom: 20px;
}

.score div {
    font-size: 13px;
    color: #aaa;
}

.score b {
    display: block;
    color: white;
    font-size: 22px;
    margin-top: 4px;
}

.board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
    aspect-ratio: 1;
}

.cell {
    border: 1px solid #34345c;
    border-radius: 15px;
    background: #111122;
    color: #00eaff;
    font-size: clamp(45px, 15vw, 70px);
    font-weight: bold;
    cursor: pointer;
    box-shadow: inset 0 0 15px #000;
    transition: .2s;
}

.cell:hover {
    background: #191935;
    border-color: #00eaff;
}

.cell:active {
    transform: scale(.94);
}

.cell.x {
    color: #00eaff;
    text-shadow: 0 0 20px #00eaff;
}

.cell.o {
    color: #ff3cac;
    text-shadow: 0 0 20px #ff3cac;
}

.status {
    height: 35px;
    margin: 18px 0 10px;
    font-size: 18px;
    color: #ddd;
}

button {
    border: none;
    border-radius: 25px;
    padding: 13px 25px;
    background: linear-gradient(90deg, #7b00ff, #00c8ff);
    color: white;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 0 20px #7b00ff55;
}

button:active {
    transform: scale(.92);
}

.win {
    animation: win .5s infinite alternate;
}

@keyframes win {
    from {
        box-shadow: 0 0 5px #00eaff;
    }
    to {
        box-shadow: 0 0 25px #00eaff;
    }
}
</style>
</head>

<body>

<div class="game">

    <h1>⭕ TIC TAC TOE ❌</h1>
    <p class="subtitle">You are X • Computer is O</p>

    <div class="score">
        <div>
            YOU
            <b id="playerScore">0</b>
        </div>

        <div>
            DRAWS
            <b id="drawScore">0</b>
        </div>

        <div>
            COMPUTER
            <b id="computerScore">0</b>
        </div>
    </div>

    <div class="board" id="board">
        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>
    </div>

    <div class="status" id="status">
        Your turn! Choose a box.
    </div>

    <button onclick="newGame()">NEW GAME</button>

</div>

<script>

const cells = document.querySelectorAll(".cell");
const statusText = document.getElementById("status");

let board = ["","","","","","","","",""];

let gameOver = false;
let playerScore = 0;
let computerScore = 0;
let drawScore = 0;

const wins = [
    [0,1,2],
    [3,4,5],
    [6,7,8],
    [0,3,6],
    [1,4,7],
    [2,5,8],
    [0,4,8],
    [2,4,6]
];

cells.forEach((cell, index) => {

    cell.addEventListener("click", () => {

        if (gameOver || board[index] !== "")
            return;

        playerMove(index);
    });

});


function playerMove(index) {

    board[index] = "X";

    cells[index].textContent = "X";
    cells[index].classList.add("x");

    let result = checkWinner();

    if (result)
        return;

    statusText.textContent = "Computer is thinking...";

    setTimeout(computerMove, 450);
}


function computerMove() {

    if (gameOver)
        return;

    let empty = [];

    for (let i = 0; i < board.length; i++) {
        if (board[i] === "")
            empty.push(i);
    }

    if (empty.length === 0)
        return;

    /*
       Computer first tries to win.
    */

    let move = findWinningMove("O");

    /*
       Then blocks the player.
    */

    if (move === -1)
        move = findWinningMove("X");

    /*
       Take center if available.
    */

    if (move === -1 && board[4] === "")
        move = 4;

    /*
       Otherwise random move.
    */

    if (move === -1)
        move = empty[Math.floor(Math.random() * empty.length)];

    board[move] = "O";

    cells[move].textContent = "O";
    cells[move].classList.add("o");

    let result = checkWinner();

    if (!result)
        statusText.textContent = "Your turn!";
}


function findWinningMove(symbol) {

    for (let combo of wins) {

        let [a,b,c] = combo;

        let values = [
            board[a],
            board[b],
            board[c]
        ];

        if (
            values.filter(x => x === symbol).length === 2 &&
            values.includes("")
        ) {

            if (board[a] === "")
                return a;

            if (board[b] === "")
                return b;

            if (board[c] === "")
                return c;
        }
    }

    return -1;
}


function checkWinner() {

    for (let combo of wins) {

        let [a,b,c] = combo;

        if (
            board[a] &&
            board[a] === board[b] &&
            board[a] === board[c]
        ) {

            gameOver = true;

            combo.forEach(i => {
                cells[i].classList.add("win");
            });

            if (board[a] === "X") {

                playerScore++;

                document.getElementById("playerScore")
                    .textContent = playerScore;

                statusText.textContent = "🎉 YOU WIN!";

            } else {

                computerScore++;

                document.getElementById("computerScore")
                    .textContent = computerScore;

                statusText.textContent = "🤖 COMPUTER WINS!";
            }

            return true;
        }
    }

    if (!board.includes("")) {

        gameOver = true;
        drawScore++;

        document.getElementById("drawScore")
            .textContent = drawScore;

        statusText.textContent = "🤝 DRAW!";

        return true;
    }

    return false;
}


function newGame() {

    board = [
        "","","",
        "","","",
        "","",""
    ];

    gameOver = false;

    cells.forEach(cell => {

        cell.textContent = "";
        cell.className = "cell";

    });

    statusText.textContent =
        "Your turn! Choose a box.";
}

</script>

</body>
</html>